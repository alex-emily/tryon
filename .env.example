NODE_ENV=production
PORT=5188

# DashScope API Key
ALIYUN_API_KEY=your_dashscope_api_key

# OSS settings used only by the server
ALIYUN_ACCESS_KEY_ID=your_oss_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_oss_access_key_secret
ALIYUN_OSS_BUCKET=your_bucket_name
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com

# Comma-separated public origins after deployment, for example:
# ALLOWED_ORIGINS=https://tryon.example.com,https://www.tryon.example.com
ALLOWED_ORIGINS=

# Abuse protection
TRYON_RATE_LIMIT=6
TRYON_RATE_WINDOW_MS=3600000
MAX_ACTIVE_GENERATIONS=2
MAX_BODY_MB=36
MAX_IMAGE_MB=14
OSS_SIGN_EXPIRES_SECONDS=900
OSS_CLEANUP_INPUTS=true
